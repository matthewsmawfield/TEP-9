# TEP corpus figure style -- matches the sibling-project convention
# (TEP-GNSS-II, TEP-WB, ...): Helvetica-class sans font, despined
# axes, light dotted grid, soft publication palette, 300 dpi output.

font.family:        sans-serif
font.sans-serif:    Helvetica, Arial, DejaVu Sans
font.size:          10
axes.labelsize:     11
axes.titlesize:     11
xtick.labelsize:    9
ytick.labelsize:    9
legend.fontsize:    9

axes.linewidth:     0.8
axes.spines.top:    False
axes.spines.right:  False
axes.grid:          True
axes.axisbelow:     True
axes.prop_cycle:    cycler('color', ['tab:blue', 'tab:red', 'tab:orange', 'tab:green', 'tab:purple', 'tab:brown', 'tab:cyan', 'tab:gray'])

grid.alpha:         0.25
grid.linestyle:     :
grid.linewidth:     0.5
grid.color:         0.56

figure.facecolor:   white
axes.facecolor:     white
figure.dpi:         110
savefig.dpi:        300
savefig.bbox:       tight
savefig.facecolor:  white

legend.frameon:     True
legend.framealpha:  0.9
legend.edgecolor:   0.8
legend.fancybox:    False
